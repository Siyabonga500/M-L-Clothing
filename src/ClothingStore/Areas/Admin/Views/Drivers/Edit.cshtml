@model ProfileViewModel
@{
    ViewData["Title"] = "Edit driver";
}
@section Head { <partial name="_LeafletHead" /> }
<a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left"></i> Drivers</a>
<h1 class="page-title mb-4">Edit @Model.FirstName @Model.Surname</h1>
<form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="surface p-4 row g-3 mx-0">
    <partial name="_ProfileFields" model="Model" />
    <partial name="_DriverFields" model="Model" />
    <div class="col-12"><button class="btn btn-primary">Save</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_LeafletScripts" /> }
