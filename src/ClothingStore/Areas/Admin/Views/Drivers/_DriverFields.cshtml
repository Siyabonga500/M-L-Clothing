@model ProfileViewModel
<div class="col-12"><div class="section-title mb-0">Vehicle</div></div>
<div class="col-md-7">
    <label asp-for="VehicleDescription" class="form-label"></label>
    <input asp-for="VehicleDescription" class="form-control" placeholder="e.g. White Toyota Hilux" />
</div>
<div class="col-md-5">
    <label asp-for="VehicleRegistration" class="form-label"></label>
    <input asp-for="VehicleRegistration" class="form-control" placeholder="e.g. ND 123-456" />
</div>
