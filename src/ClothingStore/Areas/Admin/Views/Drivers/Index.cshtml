@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "Drivers";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Drivers</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Register driver</a>
</div>
<p class="text-muted">Drivers can only be registered here. They log in with the email and password you set, and see only their assigned deliveries.</p>
@if (!Model.Any())
{
    <div class="empty-state surface"><i class="bi bi-truck"></i><p class="lead mt-3">No drivers yet.</p><a asp-action="Create" class="btn btn-primary">Register your first driver</a></div>
}
else
{
    <div class="row g-3">
        @foreach (var d in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="surface p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="rounded-circle bg-brand d-flex align-items-center justify-content-center fw-bold" style="width:46px;height:46px">@d.User.FirstName[..1]@d.User.Surname[..1]</div>
                            <div>
                                <div class="fw-bold">@d.User.FullName</div>
                                <div class="small text-muted">@d.User.Email</div>
                            </div>
                        </div>
                        @if (d.IsLocked) { <span class="status status-cancel">Locked</span> }
                    </div>
                    <div class="small mt-3">
                        <div><i class="bi bi-telephone me-1 text-brand"></i>@(d.User.PhoneNumber ?? "–")</div>
                        <div><i class="bi bi-car-front me-1 text-brand"></i>@(d.User.VehicleDescription ?? "–") @d.User.VehicleRegistration</div>
                        <div class="mt-1">
                            <a asp-area="" asp-controller="Reviews" asp-action="Index" asp-route-driverId="@d.User.Id">
                                @if (d.ReviewCount > 0)
                                {
                                    <partial name="_Stars" model="d.Rating" /> <strong>@d.Rating.ToString("0.0")</strong> <span class="text-muted">(@d.ReviewCount @(d.ReviewCount == 1 ? "review" : "reviews"))</span>
                                }
                                else { <span class="text-muted">No reviews yet</span> }
                            </a>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="small"><strong>@d.ActiveDeliveries</strong> active · <strong>@d.OrderCount</strong> delivered</div>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@d.User.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@d.User.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-three-dots"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
