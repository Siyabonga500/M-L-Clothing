@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "Manage users";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <form method="get" class="d-flex gap-2">
        <input type="search" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name or email" />
        <button class="btn btn-outline-dark">Search</button>
    </form>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Gender</th><th>Joined</th><th>Orders</th><th>Role</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@u.User.Id">@u.User.FullName</a></td>
                <td>@u.User.Email</td>
                <td>@u.User.Gender</td>
                <td>@u.User.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td>@u.OrderCount</td>
                <td>@if (u.IsAdmin) { <span class="badge bg-warning text-dark">Admin</span> } else { <span class="badge bg-light text-dark">Customer</span> }</td>
                <td>@if (u.IsLocked) { <span class="badge bg-danger">Locked</span> } else { <span class="badge bg-success">Active</span> }</td>
                <td class="text-end">
                    <partial name="_UserActions" model="u" />
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
