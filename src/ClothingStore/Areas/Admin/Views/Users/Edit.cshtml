@model ProfileViewModel
@{
    ViewData["Title"] = "Edit user";
}
<a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-link px-0"><i class="bi bi-arrow-left"></i> Back</a>
<h1 class="h3 mb-3">Edit @Model.FirstName @Model.Surname</h1>
<form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="row g-3">
    <partial name="_ProfileFields" model="Model" />
    <div class="col-12"><button type="submit" class="btn btn-dark">Save</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
