@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var drivers = (List<(ApplicationUser driver, int load)>)ViewData["Drivers"]!;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var qr = Model.QrState;
    var canAssign = Model.IsDelivery && Model.IsPaid && !Model.IsCompleted && Model.Status != OrderStatus.OutForDelivery;
}
@section Head { <partial name="_LeafletHead" /> }
<a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left"></i> All orders</a>
<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <h1 class="page-title mb-0">Order #@Model.Id</h1>
    <partial name="_OrderStatusBadge" model="Model.Status" />
    <span class="chip"><i class="bi @(Model.IsDelivery ? "bi-truck" : "bi-shop") me-1"></i>@(Model.IsDelivery ? "Delivery" : "Collection")</span>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        @if (Model.IsDelivery)
        {
            <div class="surface p-4 mb-4">
                <div class="section-title"><i class="bi bi-truck me-2"></i>Driver</div>
                @if (Model.Driver != null)
                {
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                        <div>
                            <div class="fw-bold">@Model.Driver.FullName</div>
                            <div class="small text-muted">@Model.Driver.PhoneNumber · @Model.Driver.VehicleDescription @Model.Driver.VehicleRegistration</div>
                        </div>
                        <div class="small text-end">
                            Assigned @Model.DriverAssignedAt?.ToLocalTime().ToString("dd MMM HH:mm") <span class="status status-paid ms-1">Auto-accepted</span><br />
                            Deliver by <strong>@Model.DeliveryWindowEnd?.ToLocalTime().ToString("ddd d MMM")</strong>
                            @if (Model.DepartedAt.HasValue) { <br /><span>Left store @Model.DepartedAt.Value.ToLocalTime().ToString("dd MMM HH:mm")</span> }
                        </div>
                    </div>
                }
                else if (canAssign)
                {
                    <div class="alert alert-warning small"><i class="bi bi-exclamation-triangle me-1"></i>This delivery needs a driver.</div>
                }
                @if (canAssign)
                {
                    @if (drivers.Any())
                    {
                        <form asp-action="AssignDriver" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2">
                            <select name="driverId" class="form-select" style="max-width:360px" required>
                                <option value="">Choose a driver…</option>
                                @foreach (var (d, load) in drivers)
                                {
                                    <option value="@d.Id" selected="@(d.Id == Model.DriverId)">@d.FullName (@load active)</option>
                                }
                            </select>
                            <button class="btn btn-primary">@(Model.Driver == null ? "Assign driver" : "Reassign")</button>
                        </form>
                        <div class="form-text">The driver accepts automatically. The customer is emailed a @StoreOptions.Value.DeliveryDays-day delivery window and their QR code.</div>
                    }
                    else
                    {
                        <p class="mb-0">No drivers yet. <a asp-controller="Drivers" asp-action="Create">Register a driver</a> first.</p>
                    }
                }
            </div>
        }
        else if (Model.IsPaid && !Model.IsCompleted && Model.Status != OrderStatus.ReadyForCollection)
        {
            <div class="surface p-4 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="section-title mb-1"><i class="bi bi-bag-check me-2"></i>Collection</div>
                    <div class="small text-muted">When the order is packed, mark it ready. The customer gets an email with their collection QR code.</div>
                </div>
                <form asp-action="ReadyForCollection" asp-route-id="@Model.Id" method="post">
                    <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Mark ready for collection</button>
                </form>
            </div>
        }

        @if (Model.IsDelivery && Model.DeliveryLatitude.HasValue)
        {
            <div id="orderMap" class="map mb-4"></div>
        }

        <div class="table-card mb-4"><partial name="_OrderItems" model="Model" /></div>

        <div class="surface p-4">
            <div class="section-title"><i class="bi bi-clock-history me-2"></i>Timeline</div>
            <ul class="timeline">
                @foreach (var e in Model.Events) { <li><div>@e.Message</div><div class="when">@e.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div></li> }
                <li><div>Order placed</div><div class="when">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div></li>
            </ul>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="surface p-4 mb-3">
            <div class="section-title"><i class="bi bi-qr-code me-2"></i>QR code</div>
            @switch (qr)
            {
                case QrState.Active:
                    <span class="status status-paid">Active</span>
                    <p class="small mt-2 mb-0">Issued @Model.QrGeneratedAt?.ToLocalTime().ToString("dd MMM HH:mm")<br />Expires @Model.QrExpiresAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                    break;
                case QrState.Used:
                    <span class="status status-done">Used</span>
                    <p class="small mt-2 mb-0">Scanned @Model.QrUsedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                    break;
                case QrState.Expired:
                    <span class="status status-cancel">Expired</span>
                    <p class="small mt-2 mb-0">Expired @Model.QrExpiresAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                    break;
                default:
                    <span class="status status-cancel">Not issued yet</span>
                    <p class="small mt-2 mb-0 text-muted">@(Model.IsDelivery ? "Issued when a driver is assigned." : "Issued when the order is marked ready.")</p>
                    break;
            }
            <p class="small text-muted mt-2 mb-0"><i class="bi bi-eye-slash me-1"></i>Only the customer can see the code itself.</p>
            @if (qr is QrState.Active or QrState.Expired && !Model.IsCompleted)
            {
                <form asp-action="RegenerateQr" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Issue a new QR code? The current one will stop working.');">
                    <button class="btn btn-outline-primary w-100"><i class="bi bi-arrow-clockwise me-1"></i>Generate new QR code</button>
                </form>
            }
        </div>

        <div class="surface p-4 mb-3">
            <div class="section-title"><i class="bi bi-person me-2"></i>Customer</div>
            <p class="mb-1"><a asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId" class="fw-semibold">@Model.User?.FullName</a></p>
            <p class="small mb-2">@Model.User?.Email · @Model.Phone</p>
            <div class="small"><strong>@(Model.IsDelivery ? "Deliver to" : "Collect at")</strong><br />@Model.RecipientName<br />@Model.ShippingAddress</div>
            @if (Model.DistanceKm.HasValue)
            {
                <div class="eta-box small mt-2">@Model.DistanceKm km · about @Model.EstimatedMinutes min from store</div>
            }
        </div>

        <div class="surface p-4 mb-3">
            <div class="section-title"><i class="bi bi-credit-card me-2"></i>Payment</div>
            <p class="small mb-0">
                Placed: @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")<br />
                Paid: @(Model.PaidAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "–")<br />
                <span class="text-break">Stripe: @(Model.StripePaymentIntentId ?? "–")</span>
            </p>
            <div class="d-flex justify-content-between fw-bold mt-2"><span>Total</span><span class="text-brand">@Model.Total.ToMoney()</span></div>
            @if (Model.IsPaid)
            {
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary flex-fill"><i class="bi bi-file-earmark-pdf me-1"></i>Receipt PDF</a>
                    <form asp-action="EmailReceipt" asp-route-id="@Model.Id" method="post" class="flex-fill d-grid">
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-envelope me-1"></i>Email receipt</button>
                    </form>
                </div>
            }
        </div>

        <div class="surface p-4">
            <div class="section-title"><i class="bi bi-sliders me-2"></i>Override status</div>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="input-group">
                <select name="status" class="form-select">
                    @foreach (var s in Enum.GetValues<OrderStatus>()) { <option value="@s" selected="@(s == Model.Status)">@s.Display()</option> }
                </select>
                <button class="btn btn-outline-primary">Save</button>
            </form>
            <div class="form-text">Normally statuses change automatically. Use this only to fix mistakes.</div>
        </div>
    </div>
</div>
@section Scripts {
    @if (Model.IsDelivery && Model.DeliveryLatitude.HasValue)
    {
        <partial name="_LeafletScripts" />
        <script>
            const route = StoreMaps.initRouteMap(document.getElementById('orderMap'),
                { lat: @Model.DeliveryLatitude.Value.ToString(inv), lng: @Model.DeliveryLongitude!.Value.ToString(inv), label: 'Customer' },
                @Html.Raw(Model.Status == OrderStatus.OutForDelivery && Model.DriverLatitude.HasValue
                    ? $"{{ lat: {Model.DriverLatitude.Value.ToString(inv)}, lng: {Model.DriverLongitude!.Value.ToString(inv)} }}" : "null"));
        </script>
    }
}
