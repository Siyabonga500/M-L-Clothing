@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}
<a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left"></i> All orders</a>
<h1 class="h3 mb-3">Order #@Model.Id <partial name="_OrderStatusBadge" model="Model.Status" /></h1>
<div class="row g-4">
    <div class="col-lg-8"><partial name="_OrderItems" model="Model" /></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6>Update status</h6>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="input-group">
                <select name="status" class="form-select">
                    @foreach (var s in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
                <button class="btn btn-dark">Save</button>
            </form>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="text-muted">Customer</h6>
            <p><a asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId">@Model.User?.FullName</a><br />@Model.User?.Email</p>
            <h6 class="text-muted">Deliver to</h6>
            <p>@Model.RecipientName<br />@Model.ShippingAddress<br />@Model.Phone</p>
            <h6 class="text-muted">Payment</h6>
            <p class="mb-0 small text-break">
                Placed: @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")<br />
                Paid: @(Model.PaidAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")<br />
                Stripe payment: @(Model.StripePaymentIntentId ?? "—")
            </p>
        </div></div>
    </div>
</div>
