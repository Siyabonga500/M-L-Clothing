@model List<Order>
@{
    ViewData["Title"] = "Manage orders";
    var current = ViewData["Status"] as OrderStatus?;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Orders</h1>
    <form method="get">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<OrderStatus>())
            {
                <option value="@s" selected="@(s == current)">@s</option>
            }
        </select>
    </form>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>#</th><th>Customer</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.User?.FullName<br /><small class="text-muted">@o.User?.Email</small></td>
                <td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td>@o.Items.Sum(i => i.Quantity)</td>
                <td>@o.Total.ToMoney()</td>
                <td><partial name="_OrderStatusBadge" model="o.Status" /></td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-dark">Manage</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
