@model Product
@{
    ViewData["Title"] = Model.Id == 0 ? "New product" : "Edit product";
    var images = Model.Images.OrderBy(i => i.SortOrder).ToList();
    var slotsLeft = Product.MaxImages - images.Count;
    var standardSizes = new[] { "XS", "S", "M", "L", "XL", "XXL", "3XL" };
    var presetColors = new[] { ("Black", "#1C1C1C"), ("White", "#F5F5F5"), ("Grey", "#8A8F93"), ("Navy", "#1F3A5F"), ("Blue", "#2F6DB5"),
                               ("Red", "#B3261E"), ("Green", "#2E6E4F"), ("Olive", "#6B6B2E"), ("Beige", "#D8C7A6"), ("Brown", "#6B4A2E"),
                               ("Pink", "#E59AB4"), ("Yellow", "#E0B33B") };
    var otherSizes = Model.OrderedSizes.Where(x => !standardSizes.Contains(x.Size, StringComparer.OrdinalIgnoreCase)).ToList();
}
<template id="colorRowTemplate">
    <div class="row g-2 mb-2 color-row align-items-center">
        <div class="col-2 col-md-1"><input type="color" name="colorHex" class="form-control form-control-color w-100" value="#888888" title="Swatch colour" /></div>
        <div class="col-5 col-md-6"><input name="colorName" class="form-control" placeholder="Colour, e.g. Navy" maxlength="30" /></div>
        <div class="col-3"><input type="number" name="colorQty" min="0" class="form-control" placeholder="Quantity" /></div>
        <div class="col-2"><button type="button" class="btn btn-outline-danger w-100" data-remove-color title="Remove"><i class="bi bi-x-lg"></i></button></div>
    </div>
</template>
<template id="otherRowTemplate">
    <div class="row g-2 mb-2 other-row">
        <div class="col-6"><input name="sizeName" class="form-control" placeholder="Size, e.g. 32 or XXXL" maxlength="20" /></div>
        <div class="col-4"><input type="number" name="sizeQty" min="0" class="form-control" placeholder="Quantity" /></div>
        <div class="col-2"><button type="button" class="btn btn-outline-danger w-100" data-remove-row title="Remove"><i class="bi bi-x-lg"></i></button></div>
    </div>
</template>
<a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left"></i> All products</a>
<h1 class="page-title mb-4">@ViewData["Title"]</h1>

<div class="row g-4">
    <div class="col-xl-7">
        <form asp-action="Save" method="post" enctype="multipart/form-data" class="surface p-4 row g-3 mx-0">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger col-12"></div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" list="categories" />
                <datalist id="categories"><option>Men</option><option>Women</option><option>Unisex</option><option>Kids</option><option>Shoes</option><option>Accessories</option></datalist>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="col-12"><div class="section-title mb-0 mt-2">Pricing</div></div>
            <div class="col-md-4">
                <label asp-for="OriginalPrice" class="form-label">Original price (R)</label>
                <input asp-for="OriginalPrice" class="form-control" step="0.01" id="origPrice" placeholder="Leave empty if not on sale" />
                <span asp-validation-for="OriginalPrice" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Price" class="form-label">Now price (R)</label>
                <input asp-for="Price" class="form-control" step="0.01" id="nowPrice" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="eta-box w-100 small" id="saleInfo">Not on sale</div>
            </div>

            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <div class="section-title mb-0">Sizes &amp; quantities</div>
                    <span class="eta-box small py-1">Total: <strong id="sizeTotal">0</strong></span>
                </div>
                <div class="form-text mb-2">Tick each size you stock and enter how many you have.</div>
                <div class="row g-2" id="stdSizes">
                    @foreach (var std in standardSizes)
                    {
                        var existing = Model.FindSize(std);
                        <div class="col-6 col-md-4 col-xl-3">
                            <div class="size-row @(existing != null ? "on" : "")">
                                <label class="form-check mb-0">
                                    <input type="checkbox" class="form-check-input" data-std-size="@std" @(existing != null ? "checked" : "") />
                                    <span class="form-check-label fw-semibold">@std</span>
                                </label>
                                <input type="hidden" name="sizeName" value="@std" disabled="@(existing == null)" />
                                <input type="number" name="sizeQty" min="0" class="form-control form-control-sm" placeholder="Qty"
                                       value="@existing?.Quantity" disabled="@(existing == null)" aria-label="Quantity for @std" />
                            </div>
                        </div>
                    }
                </div>

                <label class="form-check mt-3">
                    <input type="checkbox" class="form-check-input" id="otherToggle" @(otherSizes.Any() ? "checked" : "") />
                    <span class="form-check-label fw-semibold">Other sizes (e.g. 32, 9, One Size)</span>
                </label>
                <div id="otherSizes" class="mt-2" style="display:@(otherSizes.Any() ? "block" : "none")">
                    <div id="otherRows">
                        @foreach (var o in otherSizes)
                        {
                            <div class="row g-2 mb-2 other-row">
                                <div class="col-6"><input name="sizeName" class="form-control" placeholder="Size, e.g. 32 or XXXL" maxlength="20" value="@o.Size" /></div>
                                <div class="col-4"><input type="number" name="sizeQty" min="0" class="form-control" placeholder="Quantity" value="@o.Quantity" /></div>
                                <div class="col-2"><button type="button" class="btn btn-outline-danger w-100" data-remove-row title="Remove"><i class="bi bi-x-lg"></i></button></div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addOther"><i class="bi bi-plus-lg me-1"></i>Add another size</button>
                </div>
                <span class="text-danger small d-block mt-1" asp-validation-for="Sizes"></span>
                @foreach (var err in ViewData.ModelState["sizes"]?.Errors ?? new())
                {
                    <div class="text-danger small">@err.ErrorMessage</div>
                }
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                    <div class="section-title mb-0">Colours <span class="text-muted fw-normal small">(optional)</span></div>
                    <span class="eta-box small py-1" id="colorTotalBox">Colours: <strong id="colorTotal">0</strong> of <strong id="colorMax">0</strong> items</span>
                </div>
                <div class="form-text mb-2">Add each colour you stock and how many. Together they can't be more than the total from the sizes.</div>
                <div class="d-flex flex-wrap gap-1 mb-2" id="colorPresets">
                    @foreach (var (name, hex) in presetColors)
                    {
                        <button type="button" class="btn btn-sm color-preset" data-name="@name" data-hex="@hex"><span class="swatch" style="background:@hex"></span>@name</button>
                    }
                </div>
                <div id="colorRows">
                    @foreach (var c in Model.OrderedColors)
                    {
                        <div class="row g-2 mb-2 color-row align-items-center">
                            <div class="col-2 col-md-1"><input type="color" name="colorHex" class="form-control form-control-color w-100" value="@c.Hex" title="Swatch colour" /></div>
                            <div class="col-5 col-md-6"><input name="colorName" class="form-control" placeholder="Colour, e.g. Navy" maxlength="30" value="@c.Name" /></div>
                            <div class="col-3"><input type="number" name="colorQty" min="0" class="form-control" placeholder="Quantity" value="@c.Quantity" /></div>
                            <div class="col-2"><button type="button" class="btn btn-outline-danger w-100" data-remove-color title="Remove"><i class="bi bi-x-lg"></i></button></div>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" id="addColor"><i class="bi bi-plus-lg me-1"></i>Add colour</button>
                <div class="text-danger small mt-1 d-none" id="colorOver"></div>
                @foreach (var err in ViewData.ModelState["colors"]?.Errors ?? new())
                {
                    <div class="text-danger small">@err.ErrorMessage</div>
                }
            </div>

            <div class="col-12"><div class="section-title mb-0 mt-2">Add pictures (@(slotsLeft) of @Product.MaxImages left)</div></div>
            @if (slotsLeft > 0)
            {
                <div class="col-12">
                    <label class="form-label">Upload from your computer</label>
                    <input type="file" name="newImages" class="form-control" accept="image/*" multiple id="fileInput" />
                    <div class="form-text">JPG, PNG, WEBP or GIF, up to 5 MB each. You can pick several at once.</div>
                    <div class="d-flex gap-2 mt-2" id="preview"></div>
                </div>
                <div class="col-12">
                    <label class="form-label">…or paste a picture link</label>
                    <input type="url" name="imageUrl" class="form-control" placeholder="https://…" />
                </div>
            }
            else
            {
                <div class="col-12"><div class="alert alert-info small mb-0">This product has the maximum of @Product.MaxImages pictures. Remove one to add another.</div></div>
            }

            <div class="col-12 form-check ms-2 mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="col-12"><button type="submit" class="btn btn-primary btn-lg">Save product</button></div>
        </form>
    </div>

    <div class="col-xl-5">
        <div class="surface p-4">
            <div class="section-title">Pictures</div>
            @if (!images.Any())
            {
                <p class="text-muted small mb-0">No pictures yet. Add up to @Product.MaxImages using the form.</p>
            }
            <div class="row g-3">
                @foreach (var img in images)
                {
                    <div class="col-6">
                        <div class="position-relative rounded-3 overflow-hidden bg-tint" style="aspect-ratio:4/5">
                            <img src="@img.Url" class="w-100 h-100" style="object-fit:cover" alt="" onerror="this.style.visibility='hidden'" />
                            @if (img == images.First()) { <span class="sale-badge" style="background:var(--brand)">Main</span> }
                        </div>
                        <div class="d-flex gap-1 mt-1">
                            @if (img != images.First())
                            {
                                <form asp-action="MakeMainImage" asp-route-id="@img.Id" method="post" class="flex-grow-1">
                                    <button class="btn btn-sm btn-outline-primary w-100">Make main</button>
                                </form>
                            }
                            <form asp-action="DeleteImage" asp-route-id="@img.Id" method="post" class="@(img == images.First() ? "flex-grow-1" : "")" onsubmit="return confirm('Remove this picture?');">
                                <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const orig = document.getElementById('origPrice'), now = document.getElementById('nowPrice'), info = document.getElementById('saleInfo');
        function updateSale() {
            const o = parseFloat(orig.value), n = parseFloat(now.value);
            if (o > 0 && n > 0 && o > n) {
                const save = o - n, pct = Math.round(save / o * 100);
                info.innerHTML = `<span class="price-save">-${pct}% · save R ${save.toFixed(2)}</span>`;
            } else info.textContent = o > 0 && n >= o ? 'Original must be higher than now price' : 'Not on sale';
        }
        orig.addEventListener('input', updateSale); now.addEventListener('input', updateSale); updateSale();

        // ----- Sizes -----
        const totalEl = document.getElementById('sizeTotal');
        function updateTotal() {
            let t = 0;
            document.querySelectorAll('input[name="sizeQty"]:not(:disabled)').forEach(i => t += parseInt(i.value || '0', 10) || 0);
            totalEl.textContent = t;
        }
        document.querySelectorAll('[data-std-size]').forEach(cb => cb.addEventListener('change', () => {
            const row = cb.closest('.size-row');
            row.classList.toggle('on', cb.checked);
            row.querySelectorAll('input[name]').forEach(i => i.disabled = !cb.checked);
            const qty = row.querySelector('input[name="sizeQty"]');
            if (cb.checked) { if (!qty.value) qty.value = 1; qty.focus(); qty.select(); }
            updateTotal();
        }));
        const otherBox = document.getElementById('otherSizes'), otherRows = document.getElementById('otherRows');
        function addOtherRow() {
            otherRows.appendChild(document.getElementById('otherRowTemplate').content.cloneNode(true));
            otherRows.lastElementChild.querySelector('input').focus();
        }
        document.getElementById('otherToggle').addEventListener('change', e => {
            otherBox.style.display = e.target.checked ? 'block' : 'none';
            otherRows.querySelectorAll('input').forEach(i => i.disabled = !e.target.checked);
            if (e.target.checked && !otherRows.children.length) addOtherRow();
            updateTotal();
        });
        document.getElementById('addOther').addEventListener('click', addOtherRow);
        otherRows.addEventListener('click', e => {
            const btn = e.target.closest('[data-remove-row]');
            if (btn) { btn.closest('.other-row').remove(); updateTotal(); }
        });
        document.addEventListener('input', e => { if (e.target.name === 'sizeQty') updateTotal(); });
        updateTotal();

        // ----- Colours: total may not exceed the sizes total -----
        const colorRows = document.getElementById('colorRows');
        const form = colorRows.closest('form');
        function sizesTotal() { return parseInt(totalEl.textContent || '0', 10) || 0; }
        function updateColors() {
            let t = 0;
            colorRows.querySelectorAll('input[name="colorQty"]').forEach(i => t += parseInt(i.value || '0', 10) || 0);
            const max = sizesTotal(), over = t > max;
            document.getElementById('colorTotal').textContent = t;
            document.getElementById('colorMax').textContent = max;
            document.getElementById('colorTotalBox').classList.toggle('over', over);
            const msg = document.getElementById('colorOver');
            msg.classList.toggle('d-none', !over);
            msg.textContent = over ? `Colour quantities (${t}) are more than the total items (${max}). Lower them or add stock to the sizes.` : '';
            return !over;
        }
        function addColorRow(name, hex) {
            if (name && [...colorRows.querySelectorAll('input[name="colorName"]')].some(i => i.value.trim().toLowerCase() === name.toLowerCase())) return;
            colorRows.appendChild(document.getElementById('colorRowTemplate').content.cloneNode(true));
            const row = colorRows.lastElementChild;
            if (name) row.querySelector('input[name="colorName"]').value = name;
            if (hex) row.querySelector('input[name="colorHex"]').value = hex;
            row.querySelector(name ? 'input[name="colorQty"]' : 'input[name="colorName"]').focus();
            updateColors();
        }
        document.getElementById('addColor').addEventListener('click', () => addColorRow());
        document.querySelectorAll('.color-preset').forEach(b => b.addEventListener('click', () => addColorRow(b.dataset.name, b.dataset.hex)));
        colorRows.addEventListener('click', e => {
            const btn = e.target.closest('[data-remove-color]');
            if (btn) { btn.closest('.color-row').remove(); updateColors(); }
        });
        document.addEventListener('input', e => { if (['colorQty', 'sizeQty'].includes(e.target.name)) updateColors(); });
        document.addEventListener('change', e => { if (e.target.matches('[data-std-size], #otherToggle')) setTimeout(updateColors); });
        form.addEventListener('submit', e => {
            if (!updateColors()) { e.preventDefault(); document.getElementById('colorOver').scrollIntoView({ block: 'center' }); }
        });
        updateColors();

        const fileInput = document.getElementById('fileInput');
        if (fileInput) fileInput.addEventListener('change', () => {
            const max = @slotsLeft;
            const preview = document.getElementById('preview');
            preview.innerHTML = '';
            if (fileInput.files.length > max) {
                alert(`You can add ${max} more picture(s).`);
                fileInput.value = '';
                return;
            }
            [...fileInput.files].forEach(f => {
                const img = document.createElement('img');
                img.src = URL.createObjectURL(f);
                img.className = 'cart-thumb';
                preview.appendChild(img);
            });
        });
    </script>
}
