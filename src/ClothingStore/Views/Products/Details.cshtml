@model Product
@{
    ViewData["Title"] = Model.Name;
    var images = Model.Images.OrderBy(i => i.SortOrder).ToList();
    var store = StoreOptions.Value;
    string fallback = "/img/placeholder.svg";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Shop</a></li>
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>
<div class="row g-4 g-lg-5">
    <div class="col-md-6">
        <div class="gallery-main">
            <img id="mainImage" src="@(images.FirstOrDefault()?.Url ?? fallback)" alt="@Model.Name"
                 onerror="this.onerror=null;this.src='@fallback'" />
            @if (Model.IsOnSale) { <span class="sale-badge fs-6">-@Model.SavingPercent%</span> }
            @if (images.Count > 1)
            {
                <button type="button" class="gallery-nav prev" id="prevImage" aria-label="Previous picture"><i class="bi bi-chevron-left"></i></button>
                <button type="button" class="gallery-nav next" id="nextImage" aria-label="Next picture"><i class="bi bi-chevron-right"></i></button>
                <span class="gallery-count" id="imageCount">1 / @images.Count</span>
            }
        </div>
        @if (images.Count > 1)
        {
            <div class="gallery-thumbs">
                @for (var i = 0; i < images.Count; i++)
                {
                    <button type="button" class="@(i == 0 ? "active" : "")" data-src="@images[i].Url" aria-label="Picture @(i + 1)">
                        <img src="@images[i].Url" alt="" loading="lazy" onerror="this.onerror=null;this.src='@fallback'" />
                    </button>
                }
            </div>
        }
    </div>
    <div class="col-md-6">
        <span class="text-uppercase small fw-bold text-muted" style="letter-spacing:.1em">@Model.Category</span>
        <h1 class="page-title mt-1">@Model.Name</h1>
        <div class="my-3 d-flex align-items-end gap-3 flex-wrap">
            <div class="fs-4"><partial name="_PriceTag" model="Model" /></div>
        </div>
        <div class="mb-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <partial name="_StockPill" model="Model" />
                <span class="small text-muted">Total in stock: <strong class="text-brand">@Model.Stock</strong></span>
            </div>
            <div class="size-chips">
                @foreach (var sz in Model.OrderedSizes)
                {
                    <span class="size-chip @(sz.Quantity <= 0 ? "out" : "")">@sz.Size: <strong>@sz.Quantity</strong></span>
                }
            </div>
            @if (Model.HasColors)
            {
                <div class="size-chips mt-2">
                    @foreach (var c in Model.OrderedColors)
                    {
                        <span class="size-chip @(c.Quantity <= 0 ? "out" : "")"><span class="swatch" style="background:@c.Hex"></span>@c.Name: <strong>@c.Quantity</strong></span>
                    }
                </div>
            }
        </div>
        <p class="text-muted">@Model.Description</p>
        <div class="surface p-3 p-md-4 my-4">
            <partial name="_AddToCart" model="Model" />
            @if (!SignInManager.IsSignedIn(User))
            {
                <p class="small text-muted mb-0 mt-2"><i class="bi bi-info-circle me-1"></i>You'll be asked to log in or create an account first.</p>
            }
        </div>
        <div class="row g-3 small">
            <div class="col-6"><div class="d-flex gap-2"><i class="bi bi-truck fs-4 text-brand"></i><div><strong>Delivery</strong><br /><span class="text-muted">Within @store.DeliveryDays days in Durban</span></div></div></div>
            <div class="col-6"><div class="d-flex gap-2"><i class="bi bi-shop fs-4 text-brand"></i><div><strong>Collect free</strong><br /><span class="text-muted">From our Durban Central store</span></div></div></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function () {
            const thumbs = [...document.querySelectorAll('.gallery-thumbs button')];
            if (thumbs.length < 2) return;
            const main = document.getElementById('mainImage'), count = document.getElementById('imageCount');
            let current = 0;
            function show(i) {
                current = (i + thumbs.length) % thumbs.length;   // wrap around at both ends
                main.src = thumbs[current].dataset.src;
                thumbs.forEach((t, n) => t.classList.toggle('active', n === current));
                count.textContent = `${current + 1} / ${thumbs.length}`;
            }
            thumbs.forEach((b, i) => b.addEventListener('click', () => show(i)));
            document.getElementById('prevImage').addEventListener('click', () => show(current - 1));
            document.getElementById('nextImage').addEventListener('click', () => show(current + 1));
            document.addEventListener('keydown', e => {
                if (e.target.matches('input, select, textarea')) return;
                if (e.key === 'ArrowLeft') show(current - 1);
                if (e.key === 'ArrowRight') show(current + 1);
            });
            // Swipe on phones
            let startX = null;
            main.parentElement.addEventListener('touchstart', e => startX = e.touches[0].clientX, { passive: true });
            main.parentElement.addEventListener('touchend', e => {
                if (startX === null) return;
                const dx = e.changedTouches[0].clientX - startX;
                if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
                startX = null;
            });
        })();
    </script>
}
