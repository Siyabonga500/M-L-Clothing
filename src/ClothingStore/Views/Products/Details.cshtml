@model Product
@{
    ViewData["Title"] = Model.Name;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Shop</a></li>
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>
<div class="row g-4">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded product-detail-img"
             onerror="this.src='https://placehold.co/600x600?text=@Uri.EscapeDataString(Model.Name)'" />
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        <p class="fs-3 fw-semibold">@Model.Price.ToMoney()</p>
        <p>@Model.Description</p>
        <p class="text-muted">
            @if (Model.Stock > 0) { <span><i class="bi bi-check-circle text-success"></i> @Model.Stock in stock</span> }
            else { <span class="text-danger">Out of stock</span> }
        </p>
        <partial name="_AddToCart" model="Model" />
    </div>
</div>
