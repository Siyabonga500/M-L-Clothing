@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var fromCart = returnUrl != null && (returnUrl.Contains("/Cart", StringComparison.OrdinalIgnoreCase)
                                         || returnUrl.Contains("/Checkout", StringComparison.OrdinalIgnoreCase));
}
<div class="auth-wrap">
    @if (fromCart)
    {
        <div class="alert alert-info"><i class="bi bi-info-circle me-1"></i>Please log in or create an account to add items to your cart.</div>
    }
    <div class="row g-0 surface overflow-hidden">
        <div class="col-md-5 auth-side d-flex flex-column justify-content-center">
            <div class="eyebrow mb-2">Welcome back</div>
            <h2 class="mb-3">Log in to shop, track deliveries and see your orders.</h2>
            <ul class="list-unstyled small opacity-75 mb-0">
                <li class="mb-2"><i class="bi bi-check2-circle me-2"></i>Save items to your cart</li>
                <li class="mb-2"><i class="bi bi-check2-circle me-2"></i>Track your driver live</li>
                <li><i class="bi bi-check2-circle me-2"></i>Delivery or free collection</li>
            </ul>
        </div>
        <div class="col-md-7 p-4 p-md-5">
            <h1 class="h3 page-title mb-4">Log in</h1>
            <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <label asp-for="Password" class="form-label"></label>
                        <a asp-action="ForgotPassword" asp-route-email="@Model.Email" class="small fw-semibold" id="forgotLink">Forgot password?</a>
                    </div>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
            </form>
            <p class="mt-4 mb-0 text-center">New here? <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="fw-semibold">Create an account</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Carry the typed email over to the reset page.
        const link = document.getElementById('forgotLink'), email = document.getElementById('Email');
        link.addEventListener('click', () => { if (email.value) link.href = link.pathname + '?email=' + encodeURIComponent(email.value); });
    </script>
}
