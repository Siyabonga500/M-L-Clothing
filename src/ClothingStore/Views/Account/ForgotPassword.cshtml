@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="auth-wrap" style="max-width:560px">
    <div class="surface p-4 p-md-5">
        <h1 class="h3 page-title mb-1">Reset your password</h1>
        <p class="text-muted">Enter the email address and phone number on your account. If they match, you can choose a new password.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" placeholder="e.g. 082 123 4567" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Continue</button>
        </form>
        <p class="mt-4 mb-0 text-center"><a asp-action="Login" class="fw-semibold"><i class="bi bi-arrow-left me-1"></i>Back to log in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
