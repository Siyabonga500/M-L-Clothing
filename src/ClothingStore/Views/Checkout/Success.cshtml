@model Order
@{
    ViewData["Title"] = "Order confirmed";
}
<div class="surface p-5 text-center mx-auto" style="max-width:640px">
    @if (Model.IsPaid)
    {
        <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-tint" style="width:88px;height:88px">
            <i class="bi bi-check-lg text-brand" style="font-size:3rem"></i>
        </div>
        <h1 class="page-title">Thank you! Payment confirmed.</h1>
        <p class="lead">Order <strong>#@Model.Id</strong> for <strong>@Model.Total.ToMoney()</strong> has been placed.</p>
        <p class="mb-3"><i class="bi bi-envelope-check me-1 text-brand"></i>Your proof of payment has been emailed to you.</p>
        <a asp-controller="Orders" asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-outline-primary mb-3">
            <i class="bi bi-file-earmark-pdf me-1"></i>Download receipt (PDF)
        </a>
        <p class="text-muted">
            @if (Model.IsDelivery)
            {
                <span>We'll assign a driver and email you your delivery window and QR code.</span>
            }
            else
            {
                <span>We'll email you when it's ready to collect, with a QR code to show at the counter.</span>
            }
        </p>
    }
    else
    {
        <i class="bi bi-hourglass-split display-1" style="color:var(--accent)"></i>
        <h1 class="page-title mt-3">We're confirming your payment</h1>
        <p class="lead">Order <strong>#@Model.Id</strong> is waiting for Stripe to confirm payment. Refresh this page in a moment.</p>
    }
    <div class="d-flex justify-content-center gap-2 mt-4">
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">View order</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Continue shopping</a>
    </div>
</div>
