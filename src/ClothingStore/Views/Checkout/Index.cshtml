@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var store = StoreOptions.Value;
    var isDelivery = Model.Fulfilment == FulfilmentMethod.Delivery;
}
@section Head { <partial name="_LeafletHead" /> }

<h1 class="page-title mb-4">Checkout</h1>
<form asp-action="Index" method="post" id="checkoutForm">
    <div class="row g-4">
        <div class="col-lg-7">
            <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="surface p-4 mb-4">
                <div class="section-title">1. How would you like to get your order?</div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="choice h-100">
                            <input type="radio" name="Fulfilment" value="Delivery" @(isDelivery ? "checked" : "") />
                            <div class="choice-box">
                                <i class="bi bi-truck"></i>
                                <div class="fw-bold mt-2">Deliver to me</div>
                                <div class="small text-muted">Pick your address on the map. Delivered within @store.DeliveryDays days.</div>
                                <div class="small fw-semibold text-brand mt-1"><span class="text-nowrap">@store.DeliveryBaseFee.ToMoney()</span> up to @store.DeliveryBaseKm km, then <span class="text-nowrap">@store.DeliveryPerKmFee.ToMoney()/km</span></div>
                            </div>
                        </label>
                    </div>
                    <div class="col-sm-6">
                        <label class="choice h-100">
                            <input type="radio" name="Fulfilment" value="Collection" @(!isDelivery ? "checked" : "") />
                            <div class="choice-box">
                                <i class="bi bi-shop"></i>
                                <div class="fw-bold mt-2">Collect in store</div>
                                <div class="small text-muted">Free. We'll email you when it's ready.</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="surface p-4 mb-4" id="deliveryPanel" style="display:@(isDelivery ? "block" : "none")">
                <div class="section-title">2. Where should we deliver?</div>
                <partial name="_MapPicker" model='new MapPickerModel { Lat = Model.Latitude, Lng = Model.Longitude, AddressId = "ShippingAddress", ShowEta = true }' />
                <div class="mt-3">
                    <label asp-for="ShippingAddress" class="form-label">Delivery address</label>
                    <textarea asp-for="ShippingAddress" class="form-control" rows="2" placeholder="Street, suburb, city, postal code"></textarea>
                    <div class="form-text">Filled in from the map. Add a unit number or landmark to help the driver.</div>
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                </div>
            </div>

            <div class="surface p-4 mb-4" id="collectionPanel" style="display:@(!isDelivery ? "block" : "none")">
                <div class="section-title">2. Collect from our store</div>
                <div class="d-flex gap-3">
                    <i class="bi bi-geo-alt-fill fs-3 text-brand"></i>
                    <div>
                        <div class="fw-bold">@store.Name</div>
                        <div>@store.Address</div>
                        <div class="small text-muted mt-1"><i class="bi bi-clock me-1"></i>@store.CollectionHours</div>
                        <div class="small text-muted mt-2">When your order is ready you'll get an email with a QR code. Show it at the counter.</div>
                    </div>
                </div>
            </div>

            <div class="surface p-4">
                <div class="section-title">3. Contact details</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="RecipientName" class="form-label"></label>
                        <input asp-for="RecipientName" class="form-control" />
                        <span asp-validation-for="RecipientName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone (for the driver)</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="surface p-4 position-sticky" style="top:1rem">
                <div class="section-title">Order summary</div>
                <ul class="list-unstyled mb-0">
                    @foreach (var i in Model.Cart.Items)
                    {
                        <li class="d-flex align-items-center gap-3 py-2 border-bottom">
                            <img src="@i.Product!.MainImageUrl" class="cart-thumb" style="width:48px;height:56px" alt="" onerror="this.style.visibility='hidden'" />
                            <div class="flex-grow-1 small">
                                <div class="fw-semibold">@i.Product.Name</div>
                                <div class="text-muted">Size @i.Size · Qty @i.Quantity</div>
                            </div>
                            <span class="fw-semibold">@((i.Product.Price * i.Quantity).ToMoney())</span>
                        </li>
                    }
                </ul>
                <div class="d-flex justify-content-between mt-3"><span class="text-muted">Items</span><span>@Model.Cart.Total.ToMoney()</span></div>
                <div class="d-flex justify-content-between mt-1">
                    <span class="text-muted" id="feeLabel">Delivery fee</span>
                    <span class="fw-semibold" id="feeValue">Pick your address</span>
                </div>
                <div class="small text-muted" id="feeNote"></div>
                <div class="d-flex justify-content-between fs-5 fw-bold mt-2 pt-2 border-top"><span>Total</span><span class="text-brand" id="orderTotal">@Model.Cart.Total.ToMoney()</span></div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                    <i class="bi bi-credit-card me-2"></i>Confirm &amp; pay <span id="payTotal">@Model.Cart.Total.ToMoney()</span>
                </button>
                <p class="small text-muted text-center mt-2 mb-0"><i class="bi bi-lock me-1"></i>You'll pay on Stripe's secure page.</p>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_LeafletScripts" />
    <script>
        // ----- Delivery fee (same rule as the server: StoreSettings.DeliveryFee) -----
        const itemsTotal = @Json.Serialize(Model.Cart.Total);
        const money = v => 'R ' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        function deliveryFee(km) {
            if (km <= STORE.baseKm) return STORE.baseFee;
            return STORE.baseFee + Math.ceil(Math.round((km - STORE.baseKm) * 10) / 10) * STORE.perKmFee;
        }
        function updateTotals() {
            const delivery = document.querySelector('input[name="Fulfilment"]:checked').value === 'Delivery';
            const lat = parseFloat(document.querySelector('[data-lat]').value), lng = parseFloat(document.querySelector('[data-lng]').value);
            let fee = 0;
            const label = document.getElementById('feeLabel'), value = document.getElementById('feeValue'), note = document.getElementById('feeNote');
            if (!delivery) {
                label.textContent = 'Collection'; value.textContent = 'Free'; note.textContent = '';
            } else if (isNaN(lat) || isNaN(lng)) {
                label.textContent = 'Delivery fee'; value.textContent = 'Pick your address'; note.textContent = '';
            } else {
                const est = StoreMaps.estimate(STORE.lat, STORE.lng, lat, lng);
                fee = deliveryFee(est.km);
                label.textContent = `Delivery fee (${est.km} km)`;
                value.textContent = money(fee);
                note.textContent = est.km <= STORE.baseKm
                    ? `Flat ${money(STORE.baseFee)} for up to ${STORE.baseKm} km.`
                    : `${money(STORE.baseFee)} for the first ${STORE.baseKm} km + ${Math.ceil(Math.round((est.km - STORE.baseKm) * 10) / 10)} km × ${money(STORE.perKmFee)}.`;
            }
            document.getElementById('orderTotal').textContent = money(itemsTotal + fee);
            document.getElementById('payTotal').textContent = money(itemsTotal + fee);
        }
        document.addEventListener('change', e => { if (e.target.matches('[data-lat], input[name="Fulfilment"]')) updateTotals(); });
        document.addEventListener('DOMContentLoaded', updateTotals);

        const deliveryPanel = document.getElementById('deliveryPanel');
        const collectionPanel = document.getElementById('collectionPanel');
        document.querySelectorAll('input[name="Fulfilment"]').forEach(r => r.addEventListener('change', () => {
            const delivery = document.querySelector('input[name="Fulfilment"]:checked').value === 'Delivery';
            deliveryPanel.style.display = delivery ? 'block' : 'none';
            collectionPanel.style.display = delivery ? 'none' : 'block';
            const picker = deliveryPanel.querySelector('[data-map-picker]');
            if (delivery && picker._map) setTimeout(() => picker._map.invalidateSize(), 50);
        }));
        document.getElementById('checkoutForm').addEventListener('submit', e => {
            const delivery = document.querySelector('input[name="Fulfilment"]:checked').value === 'Delivery';
            if (delivery && !document.querySelector('[data-lat]').value) {
                e.preventDefault();
                alert('Please pick your delivery location on the map.');
            }
        });
    </script>
}
