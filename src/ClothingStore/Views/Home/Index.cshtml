@model HomeViewModel
@{
    ViewData["Title"] = "Shop";
    var store = StoreOptions.Value;
    var onSale = Model.Products.Count(p => p.IsOnSale);
}

<section class="photo-hero mb-4" style="--hero-img: url('@store.HeroImageUrl')">
    <div class="photo-hero-inner">
        <h1 class="photo-hero-title">@store.HeroTitle</h1>
        <p class="photo-hero-sub">@store.HeroSubtitle</p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a href="#products" class="btn btn-hero">Shop now</a>
            <a asp-action="Contact" class="btn btn-hero-outline">Contact us</a>
        </div>
    </div>
</section>

<form method="get" class="surface p-3 mb-3">
    <input type="hidden" name="category" value="@Model.Category" />
    <div class="row g-2 align-items-end">
        <div class="col-lg-5">
            <label class="form-label small mb-1" for="search">Search</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" id="search" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search clothes…" />
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1" for="minPrice">Min price (R)</label>
            <input type="number" id="minPrice" name="minPrice" value="@Model.MinPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="1" class="form-control" placeholder="0" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small mb-1" for="maxPrice">Max price (R)</label>
            <input type="number" id="maxPrice" name="maxPrice" value="@Model.MaxPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="1" class="form-control" placeholder="Any" />
        </div>
        <div class="col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Search</button>
            @if (Model.HasFilters)
            {
                <a asp-action="Index" class="btn btn-outline-primary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
</form>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div class="chip-row">
        <a class="chip @(string.IsNullOrEmpty(Model.Category) ? "active" : "")" asp-action="Index"
           asp-route-search="@Model.Search" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice">All</a>
        @foreach (var c in Model.Categories)
        {
            <a class="chip @(c == Model.Category ? "active" : "")" asp-action="Index" asp-route-category="@c"
               asp-route-search="@Model.Search" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice">@c</a>
        }
    </div>
    <span class="small text-muted">
        @Model.Products.Count item(s)
        @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
        {
            <span>· @(Model.MinPrice?.ToMoney() ?? "R 0.00") – @(Model.MaxPrice?.ToMoney() ?? "any price")</span>
        }
    </span>
</div>

@if (!Model.Products.Any())
{
    <div class="empty-state surface">
        <i class="bi bi-search"></i>
        <p class="lead mt-3 mb-1">No products found</p>
        <a asp-action="Index" class="btn btn-outline-primary mt-2">Clear filters</a>
    </div>
}

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4" id="products">
    @foreach (var p in Model.Products)
    {
        <div class="col">
            <div class="product-card">
                <a class="thumb" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">
                    <img src="@p.MainImageUrl" alt="@p.Name" loading="lazy"
                         onerror="this.onerror=null;this.src='/img/placeholder.svg'" />
                    @if (p.IsOnSale) { <span class="sale-badge">-@p.SavingPercent%</span> }
                </a>
                <div class="body">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="category">@p.Category</span>
                        <partial name="_StockPill" model="p" />
                    </div>
                    <a class="name" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Name</a>
                    <div class="mb-3"><partial name="_PriceTag" model="p" /></div>
                    <div class="mt-auto">
                        <partial name="_AddToCart" model="p" view-data='new ViewDataDictionary(ViewData) { ["Compact"] = true }' />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<section class="hero mt-5">
    <div class="row align-items-center position-relative" style="z-index:1">
        <div class="col-lg-8">
            <div class="eyebrow mb-2">New season collection</div>
            <h1 class="mb-3">Dress well.<br />Delivered to your door.</h1>
            <p class="lead mb-0 opacity-75">Shop the latest styles and choose delivery anywhere in Durban or free collection from our store.</p>
            <div class="hero-perks">
                <span><i class="bi bi-truck"></i>Delivered within @store.DeliveryDays days</span>
                <span><i class="bi bi-shop"></i>Free in-store collection</span>
                <span><i class="bi bi-qr-code"></i>QR-secured hand-over</span>
                <span><i class="bi bi-shield-lock"></i>Secure Stripe checkout</span>
            </div>
        </div>
        @if (onSale > 0)
        {
            <div class="col-lg-4 d-none d-lg-block text-center">
                <div class="d-inline-block p-4 rounded-4" style="background:rgba(255,255,255,.08)">
                    <div class="display-5 fw-bold" style="color:var(--accent)">SALE</div>
                    <div class="opacity-75">@onSale items marked down</div>
                </div>
            </div>
        }
    </div>
</section>
