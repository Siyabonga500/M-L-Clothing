@model ContactViewModel
@{
    ViewData["Title"] = "Contact us";
    var store = StoreOptions.Value;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
@section Head { <partial name="_LeafletHead" /> }
<h1 class="page-title mb-1">Contact us</h1>
<p class="text-muted mb-4">Questions about an order, sizes or delivery? Send us a message or visit the store.</p>
<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Contact" method="post" class="surface p-4 row g-3 mx-0">
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">Phone (optional)</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Message" class="form-label"></label>
                <textarea asp-for="Message" class="form-control" rows="6" placeholder="How can we help? Include your order number if it's about an order."></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="col-12"><button class="btn btn-primary btn-lg"><i class="bi bi-send me-1"></i>Send message</button></div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="surface p-4 mb-3">
            <div class="section-title">@store.Name</div>
            <p class="mb-2"><i class="bi bi-geo-alt me-2 text-brand"></i>@store.Address</p>
            <p class="mb-2"><i class="bi bi-clock me-2 text-brand"></i>@store.CollectionHours</p>
            @if (!string.IsNullOrWhiteSpace(store.Phone))
            {
                <p class="mb-2"><i class="bi bi-telephone me-2 text-brand"></i><a href="tel:@store.Phone">@store.Phone</a></p>
            }
            @if (!string.IsNullOrWhiteSpace(store.Email))
            {
                <p class="mb-0"><i class="bi bi-envelope me-2 text-brand"></i><a href="mailto:@store.Email">@store.Email</a></p>
            }
        </div>
        <div id="storeMap" class="map"></div>
        <a class="btn btn-outline-primary btn-sm mt-2" target="_blank" rel="noopener"
           href="https://www.google.com/maps/dir/?api=1&destination=@store.Latitude.ToString(inv),@store.Longitude.ToString(inv)">
            <i class="bi bi-sign-turn-right me-1"></i>Directions
        </a>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_LeafletScripts" />
    <script>StoreMaps.initRouteMap(document.getElementById('storeMap'), null, null).map.setView([STORE.lat, STORE.lng], 16);</script>
}
