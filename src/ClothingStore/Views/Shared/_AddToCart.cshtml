@model Product
@* Signed-in users post straight to the cart. Visitors are sent to the login page first
   (the [Authorize] attribute on CartController does the redirect), then the item is added. *@
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var compact = ViewData["Compact"] as bool? ?? false;
}
@if (Model.Stock <= 0)
{
    <button class="btn btn-secondary w-100" disabled>Out of stock</button>
}
else if (signedIn)
{
    <form asp-controller="Cart" asp-action="Add" method="post">
        <input type="hidden" name="productId" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <div class="input-group">
            <select name="size" class="form-select" aria-label="Size">
                @foreach (var s in Model.SizeList) { <option>@s</option> }
            </select>
            @if (!compact)
            {
                <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="max-width:90px" aria-label="Quantity" />
            }
            <button type="submit" class="btn btn-dark"><i class="bi bi-cart-plus"></i> Add to cart</button>
        </div>
    </form>
}
else
{
    <form asp-controller="Cart" asp-action="AddAfterLogin" method="get">
        <input type="hidden" name="productId" value="@Model.Id" />
        <div class="input-group">
            <select name="size" class="form-select" aria-label="Size">
                @foreach (var s in Model.SizeList) { <option>@s</option> }
            </select>
            @if (!compact)
            {
                <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="max-width:90px" aria-label="Quantity" />
            }
            <button type="submit" class="btn btn-dark"><i class="bi bi-cart-plus"></i> Add to cart</button>
        </div>
    </form>
}
