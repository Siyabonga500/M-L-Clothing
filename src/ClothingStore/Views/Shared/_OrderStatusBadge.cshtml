@model OrderStatus
@{
    var css = Model switch
    {
        OrderStatus.PendingPayment => "status-pending",
        OrderStatus.Paid => "status-paid",
        OrderStatus.Processing or OrderStatus.DriverAssigned or OrderStatus.ReadyForCollection => "status-progress",
        OrderStatus.OutForDelivery => "status-moving",
        OrderStatus.Delivered or OrderStatus.Collected => "status-done",
        _ => "status-cancel"
    };
}
<span class="status @css">@Model.Display()</span>
