@model Product
@{ var firstAvailable = Model.OrderedSizes.FirstOrDefault(s => s.Quantity > 0); }
@foreach (var s in Model.OrderedSizes)
{
    <option value="@s.Size" data-qty="@s.Quantity" disabled="@(s.Quantity <= 0)" selected="@(s == firstAvailable)">
        @s.Size @(s.Quantity <= 0 ? "– sold out" : s.Quantity <= 5 ? $"– only {s.Quantity} left" : $"({s.Quantity})")
    </option>
}
