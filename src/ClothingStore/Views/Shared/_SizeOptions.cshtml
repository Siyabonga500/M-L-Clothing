@model Product
@* Only sizes that are in stock can be chosen; sold-out sizes are left out of the list. *@
@{ var inStock = Model.OrderedSizes.Where(s => s.Quantity > 0).ToList(); }
@foreach (var s in inStock)
{
    <option value="@s.Size" data-qty="@s.Quantity" selected="@(s == inStock[0])">
        @s.Size @(s.Quantity <= 5 ? $"– only {s.Quantity} left" : $"({s.Quantity})")
    </option>
}
