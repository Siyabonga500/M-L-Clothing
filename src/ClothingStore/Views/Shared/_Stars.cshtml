@model double
@* Shows 0–5 stars; halves are rounded to the nearest half star. *@
@{ var v = Math.Round(Model * 2) / 2; }
<span class="stars" title="@Model.ToString("0.0") out of 5">
    @for (var i = 1; i <= 5; i++)
    {
        var icon = v >= i ? "bi-star-fill" : v >= i - 0.5 ? "bi-star-half" : "bi-star";
        <i class="bi @icon"></i>
    }
</span>
