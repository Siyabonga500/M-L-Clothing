@{
    var store = StoreOptions.Value;
    var signedIn = SignInManager.IsSignedIn(User);
    var isAdmin = User.IsInRole(Roles.Admin);
    var isDriver = User.IsInRole(Roles.Driver);
    var isShopper = Roles.IsShopper(User);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    string Active(string c, string? a = null) => c == controller && a == area ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#183630" />
    <title>@ViewData["Title"] · @store.Name</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        @if (area == "Admin")
        {
            @* Admin pages use a compact top menu bar instead of the shop navigation. *@
            <nav class="navbar navbar-expand-lg navbar-dark admin-nav mb-4">
                <div class="container-fluid px-3 px-lg-4">
                    <a class="navbar-brand d-flex align-items-center" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-basket2-fill me-2"></i>@store.Name
                    </a>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
                            aria-controls="adminNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="adminNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @Active("Dashboard", "Admin")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "Orders" && action != "Scan" && area == "Admin" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Products", "Admin")" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Drivers", "Admin")" asp-area="Admin" asp-controller="Drivers" asp-action="Index">Drivers</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Users", "Admin")" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "Orders" && action == "Scan" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Scan">Scan QR</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Emails", "Admin")" asp-area="Admin" asp-controller="Emails" asp-action="Index">Emails</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">View shop</a></li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</a></li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }
        else
        {
        <nav class="navbar navbar-expand-lg navbar-dark site-nav mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-basket2-fill"></i></span>@store.Name
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-lg-1 mt-2 mt-lg-0">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-shop me-1"></i>Shop</a></li>
                        @if (isShopper)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Orders")" asp-area="" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-1"></i>My Orders</a></li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @(area == "Admin" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Admin</a></li>
                        }
                        @if (isDriver)
                        {
                            <li class="nav-item"><a class="nav-link @(area == "Driver" ? "active" : "")" asp-area="Driver" asp-controller="Deliveries" asp-action="Index"><i class="bi bi-truck me-1"></i>My Deliveries</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Driver" asp-controller="Deliveries" asp-action="Scan"><i class="bi bi-qr-code-scan me-1"></i>Scan QR</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @if (signedIn)
                        {
                            @if (isShopper)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("Cart")" asp-area="" asp-controller="Cart" asp-action="Index">@await Component.InvokeAsync("CartCount")</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                                    @if (isAdmin) { <span class="role-chip ms-1">ADMIN</span> }
                                    @if (isDriver) { <span class="role-chip ms-1">DRIVER</span> }
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Create account</a></li>
                            <li class="nav-item"><a class="btn btn-login btn-sm ms-lg-2 px-3" asp-area="" asp-controller="Account" asp-action="Login">Log in</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        }
    </header>

    <main role="main" class="@(area == "Admin" ? "container-fluid px-3 px-lg-4" : "container") flex-grow-1 pb-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer pt-5">
        <div class="container">
            <div class="row g-4 pb-4">
                <div class="col-md-5">
                    <h5 class="text-white"><i class="bi bi-basket2-fill me-2" style="color:var(--accent)"></i>@store.Name</h5>
                    <p class="small mb-0">Quality clothing for every season, delivered to your door across Durban or ready to collect in store.</p>
                </div>
                <div class="col-md-4">
                    <h6>Visit / collect</h6>
                    <p class="small mb-1"><i class="bi bi-geo-alt me-1"></i>@store.Address</p>
                    <p class="small mb-0"><i class="bi bi-clock me-1"></i>@store.CollectionHours</p>
                </div>
                <div class="col-md-3">
                    <h6>Shopping</h6>
                    <p class="small mb-1"><i class="bi bi-truck me-1"></i>Delivery within @store.DeliveryDays days</p>
                    <p class="small mb-1"><i class="bi bi-qr-code me-1"></i>QR-confirmed hand-over</p>
                    <p class="small mb-0"><i class="bi bi-lock me-1"></i>Secure payments by Stripe</p>
                </div>
            </div>
            <div class="bottom py-3 small d-flex justify-content-between flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year @store.Name</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
