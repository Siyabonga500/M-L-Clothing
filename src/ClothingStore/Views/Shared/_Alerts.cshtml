@foreach (var (key, css, icon) in new[] { ("Success", "alert-success", "bi-check-circle-fill"), ("Error", "alert-danger", "bi-exclamation-triangle-fill"), ("Info", "alert-info", "bi-info-circle-fill") })
{
    if (TempData[key] is string msg)
    {
        <div class="alert @css alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi @icon"></i><span>@msg</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}
