@model List<Order>
@{
    ViewData["Title"] = "My orders";
}
<h1 class="page-title mb-4">My orders</h1>
@{ var filter = (OrderHistoryFilter)ViewData["Filter"]!; var total = (int)ViewData["TotalOrders"]!; }
@if (total > 0)
{
    <partial name="_OrderFilter" model="filter" />
    <p class="small text-muted">Showing @Model.Count of @total order(s)@(filter.HasDates ? $" from {filter.From?.ToString("dd MMM yyyy") ?? "the start"} to {filter.To?.ToString("dd MMM yyyy") ?? "today"}" : "").</p>
}
@if (total > 0 && !Model.Any())
{
    <div class="empty-state surface">
        <i class="bi bi-calendar-x"></i>
        <p class="lead mt-3">No orders in those dates.</p>
        <a asp-action="Index" class="btn btn-outline-primary">Show all orders</a>
    </div>
}
else if (!Model.Any())
{
    <div class="empty-state surface">
        <i class="bi bi-box-seam"></i>
        <p class="lead mt-3">You haven't placed any orders yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Start shopping</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var o in Model)
        {
            <div class="col-md-6 col-xl-4">
                <a asp-action="Details" asp-route-id="@o.Id" class="surface p-3 d-block text-body h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-bold fs-5">Order #@o.Id</div>
                            <div class="small text-muted">@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                        </div>
                        <partial name="_OrderStatusBadge" model="o.Status" />
                    </div>
                    <div class="d-flex justify-content-between align-items-end mt-3">
                        <div class="small text-muted">
                            <i class="bi @(o.IsDelivery ? "bi-truck" : "bi-shop") me-1"></i>@(o.IsDelivery ? "Delivery" : "Collection")
                            · @o.Items.Sum(i => i.Quantity) item(s)
                        </div>
                        <div class="fw-bold text-brand">@o.Total.ToMoney()</div>
                    </div>
                </a>
            </div>
        }
    </div>
}
